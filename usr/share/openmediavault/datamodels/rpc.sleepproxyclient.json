[
  {
    "type": "rpc",
    "id": "rpc.sleepproxyclient.setsettings",
    "params": {
        "type": "object",
        "properties": {
          "enable": {
            "type": "boolean",
            "required": true
          },
          "interfaces": {
            "type": "string",
            "required": true,
            "pattern": "^[a-zA-Z0-9.,]*$"
          },
          "leaseTime": {
            "type": "number",
            "required": true,
            "min": 7200,
            "max": 43200,
            "patternType": "integer"
          },
          "server": {
            "type": "string",
            "required": false,
            "pattern": "^[a-zA-Z0-9.,]*$"
          },
          "enableRTC": {
            "type": "boolean",
            "required": true
          },
          "enableDebug": {
            "type": "boolean",
            "required": true
          } 
        }
    }
  }
]
